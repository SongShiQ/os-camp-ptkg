{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/source-contract.schema.json",
  "title": "PTKG Source Contract",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["repository", "target", "curriculum_boundary", "non_goals", "environment", "build", "tests", "unresolved_questions", "checkout"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "curriculum_boundary": { "const": "pre_project_readiness" },
        "non_goals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "environment": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "build": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "unresolved_questions": { "type": "array", "items": { "type": "string" } },
        "previous_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "checkout": {
          "type": "object",
          "required": ["expected_tree", "candidates"],
          "additionalProperties": false,
          "properties": {
            "expected_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["repository", "ref"],
                "additionalProperties": false,
                "properties": {
                  "repository": { "type": "string", "minLength": 1 },
                  "ref": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
