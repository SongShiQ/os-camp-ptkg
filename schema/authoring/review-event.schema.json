{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/review-event.schema.json",
  "title": "PTKG Review or Exception Event",
  "type": "object",
  "required": ["spec_version", "event_id", "run_id", "object_ref", "object_hash", "action", "actor_id", "actor_roles", "authentication", "reason", "scope", "created_at"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "review-event@0.1" },
    "event_id": { "type": "string", "pattern": "^(review|exception)\\." },
    "run_id": { "type": "string", "pattern": "^run\\." },
    "object_ref": { "type": "string", "minLength": 1 },
    "object_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action": { "enum": ["accept", "reject", "request_changes", "approve_exception", "publish", "revoke"] },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_roles": { "type": "array", "minItems": 1, "items": { "enum": ["project_mentor", "course_teacher", "release_owner"] } },
    "authentication": { "enum": ["authenticated", "local_unverified_review"] },
    "reason": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "rule_code": { "type": "string" },
    "compensating_controls": { "type": "array", "items": { "type": "string" } },
    "expires_at": { "type": "string", "format": "date-time" },
    "bound_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "invalidates_on": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "approve_exception" } } },
      "then": {
        "required": ["rule_code", "compensating_controls", "invalidates_on"],
        "anyOf": [{ "required": ["expires_at"] }, { "required": ["bound_commit"] }]
      }
    }
  ]
}
