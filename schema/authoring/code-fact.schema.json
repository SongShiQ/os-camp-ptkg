{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/code-fact.schema.json",
  "title": "PTKG Code Fact",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["fact_kind", "anchors"],
      "properties": {
        "fact_kind": { "enum": ["module", "symbol", "call", "dependency", "state", "test", "build_entry"] },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/anchor" }
        },
        "from_ref": { "type": "string" },
        "to_ref": { "type": "string" }
      }
    }
  ],
  "unevaluatedProperties": false
}
