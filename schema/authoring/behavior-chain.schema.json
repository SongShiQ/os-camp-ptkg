{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/behavior-chain.schema.json",
  "title": "PTKG Behavior Chain",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["behavior_kind", "title", "preconditions", "entry", "state", "success_exit", "failure_exit", "cleanup", "invariants", "concurrency", "anchors", "evidence_refs"],
      "properties": {
        "behavior_kind": { "enum": ["observation", "state_change", "resource_lifecycle"] },
        "title": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "entry": { "type": "string", "minLength": 1 },
        "state": {
          "type": "object",
          "required": ["reads", "writes"],
          "additionalProperties": false,
          "properties": {
            "reads": { "type": "array", "items": { "type": "string" } },
            "writes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "success_exit": { "type": "string", "minLength": 1 },
        "failure_exit": { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/applicability" },
        "cleanup": { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/applicability" },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "concurrency": { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/applicability" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/anchor" }
        },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "coverage_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  ],
  "unevaluatedProperties": false
}
