{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/execution-result.schema.json",
  "title": "PTKG Execution Result",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["slice_ref", "result_status", "environment_hash", "toolchain_hash", "commands", "exit_code", "artifact_hashes", "duration_ms", "limits", "sandbox", "expected", "actual", "test_classes", "reset"],
      "properties": {
        "slice_ref": { "type": "string", "pattern": "^slice\\." },
        "result_status": { "enum": ["succeeded", "failed", "inconclusive"] },
        "environment_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "toolchain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exit_code": { "type": "integer" },
        "artifact_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "limits": {
          "type": "object",
          "required": ["timeout_seconds", "memory_mb", "processes"],
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "memory_mb": { "type": "integer", "minimum": 1 },
            "processes": { "type": "integer", "minimum": 1 }
          }
        },
        "sandbox": {
          "type": "object",
          "required": ["network", "filesystem", "secrets", "resettable", "push_allowed"],
          "additionalProperties": false,
          "properties": {
            "network": { "enum": ["disabled", "allowlisted"] },
            "filesystem": { "enum": ["disposable_worktree", "read_only"] },
            "secrets": { "const": "none" },
            "resettable": { "const": true },
            "push_allowed": { "const": false }
          }
        },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "test_classes": {
          "type": "object",
          "required": ["positive", "negative", "concurrency", "regression"],
          "additionalProperties": false,
          "properties": {
            "positive": { "type": "boolean" },
            "negative": { "type": "boolean" },
            "concurrency": { "enum": [true, false, "not_applicable"] },
            "regression": { "type": "boolean" }
          }
        },
        "fault_detection": {
          "type": "object",
          "required": ["baseline_passed", "fault_failed"],
          "additionalProperties": false,
          "properties": {
            "baseline_passed": { "type": "boolean" },
            "fault_failed": { "type": "boolean" },
            "fault_ref": { "type": "string" }
          }
        },
        "reset": { "type": "object", "required": ["succeeded"], "additionalProperties": false, "properties": { "succeeded": { "type": "boolean" }, "log_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
      }
    }
  ],
  "unevaluatedProperties": false
}
