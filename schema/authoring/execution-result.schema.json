{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/execution-result.schema.json",
  "title": "PTKG Execution Result",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["slice_ref", "result_status", "environment_hash", "toolchain_hash", "commands", "exit_code", "artifact_hashes", "duration_ms", "limits", "sandbox", "expected", "actual", "test_classes", "reset"],
      "properties": {
        "slice_ref": { "type": "string", "pattern": "^slice\\." },
        "result_status": { "enum": ["succeeded", "failed", "inconclusive"] },
        "environment_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "toolchain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commands": { "type": "array", "items": { "type": "string" } },
        "exit_code": { "type": "integer" },
        "artifact_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "artifact_files": {
          "type": "object",
          "required": ["stdout", "stderr", "environment", "phases", "reset"],
          "additionalProperties": false,
          "properties": {
            "stdout": { "type": "string", "pattern": "^reports/execution/[A-Za-z0-9._-]+/stdout\\.log$" },
            "stderr": { "type": "string", "pattern": "^reports/execution/[A-Za-z0-9._-]+/stderr\\.log$" },
            "environment": { "type": "string", "pattern": "^reports/execution/[A-Za-z0-9._-]+/environment\\.json$" },
            "phases": { "type": "string", "pattern": "^reports/execution/[A-Za-z0-9._-]+/phases\\.json$" },
            "reset": { "type": "string", "pattern": "^reports/execution/[A-Za-z0-9._-]+/reset\\.json$" }
          }
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "limits": {
          "type": "object",
          "required": ["timeout_seconds", "memory_mb", "processes"],
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "memory_mb": { "type": "integer", "minimum": 1 },
            "processes": { "type": "integer", "minimum": 1 }
          }
        },
        "sandbox": {
          "type": "object",
          "required": ["network", "filesystem", "secrets", "resettable", "push_allowed"],
          "additionalProperties": false,
          "properties": {
            "network": { "enum": ["disabled", "allowlisted"] },
            "filesystem": { "enum": ["disposable_worktree", "read_only"] },
            "secrets": { "const": "none" },
            "resettable": { "const": true },
            "push_allowed": { "const": false }
          }
        },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "test_classes": {
          "type": "object",
          "required": ["positive", "negative", "concurrency", "regression"],
          "additionalProperties": false,
          "properties": {
            "positive": { "type": "boolean" },
            "negative": { "type": "boolean" },
            "concurrency": { "enum": [true, false, "not_applicable"] },
            "regression": { "type": "boolean" }
          }
        },
        "fault_detection": {
          "type": "object",
          "required": ["baseline_passed", "fault_failed"],
          "additionalProperties": false,
          "properties": {
            "baseline_passed": { "type": "boolean" },
            "fault_failed": { "type": "boolean" },
            "fault_ref": { "type": "string" }
          }
        },
        "source_snapshot": {
          "type": "object",
          "required": ["repo", "commit", "tree"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "image": {
          "type": "object",
          "required": ["reference", "id", "repo_digests"],
          "additionalProperties": false,
          "properties": {
            "reference": { "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$" },
            "id": { "type": "string", "minLength": 1 },
            "repo_digests": { "type": "array", "items": { "type": "string" } }
          }
        },
        "runtime_cache": {
          "type": "object",
          "required": ["spec_version", "root_hash", "files_hash", "prepare_command_hash", "file_count", "total_bytes", "verified_unchanged"],
          "additionalProperties": false,
          "properties": {
            "spec_version": { "const": "ptkg-runtime@1" },
            "root_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "files_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "prepare_command_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "file_count": { "type": "integer", "minimum": 1 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "verified_unchanged": { "type": "boolean" }
          }
        },
        "phase_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "exit_code", "timed_out", "expected"],
            "additionalProperties": false,
            "properties": {
              "name": { "enum": ["baseline", "fault"] },
              "exit_code": { "type": "integer" },
              "timed_out": { "type": "boolean" },
              "expected": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reset": { "type": "object", "required": ["succeeded"], "additionalProperties": false, "properties": { "succeeded": { "type": "boolean" }, "log_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
      }
    }
  ],
  "unevaluatedProperties": false
}
