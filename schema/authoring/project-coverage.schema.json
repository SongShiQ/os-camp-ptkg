{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/authoring/0.1/project-coverage.schema.json",
  "title": "PTKG Project Coverage",
  "allOf": [
    { "$ref": "https://os-camp.dev/ptkg/authoring/0.1/common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["release_level", "required_unit_ids", "units", "platform_family", "reuse_links"],
      "properties": {
        "release_level": { "enum": ["author_preview", "internal_pilot", "complete_course"] },
        "required_unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "required", "critical", "status", "implementation_state", "source_refs"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^coverage\\." },
              "title": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "critical": { "type": "boolean" },
              "status": { "enum": ["skeleton", "source_verified", "teachable", "pilot_validated", "unresolved", "excluded"] },
              "implementation_state": { "enum": ["present", "partial", "absent", "conflicting", "unresolved"] },
              "source_refs": { "type": "array", "items": { "type": "string" } },
              "behavior_refs": { "type": "array", "items": { "type": "string" } },
              "exclusion_event_ref": { "type": "string" }
            }
          }
        },
        "platform_family": {
          "type": "object",
          "required": ["id", "shared_trunk_refs"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^platform\\." },
            "shared_trunk_refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "reuse_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "relation", "alignment"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "relation": { "enum": ["exact_reuse", "specializes", "extends", "conflicts"] },
              "alignment": {
                "type": "object",
                "required": ["learning_goal", "prerequisites", "evidence"],
                "additionalProperties": false,
                "properties": {
                  "learning_goal": { "type": "boolean" },
                  "prerequisites": { "type": "boolean" },
                  "evidence": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
