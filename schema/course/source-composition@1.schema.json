{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-camp.dev/ptkg/course/source-composition@1.schema.json",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$" },
    "sha64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "anchor_ids"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/id" },
        "anchor_ids": { "allOf": [{ "$ref": "#/$defs/ids" }, { "minItems": 1 }] }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version", "id", "from_source_contract_root", "to_source_contract_root", "canonical_capability_id", "from_binding_and_anchors", "to_binding_and_anchors", "behavior_relation", "known_differences", "inheritable_evidence_kinds", "forbidden_inheritance", "migration_practice_id", "review_event_id", "status", "content_hash"],
      "properties": {
        "spec_version": { "const": "source-bridge@1" },
        "id": { "$ref": "#/$defs/id" },
        "from_source_contract_root": { "$ref": "#/$defs/sha64" },
        "to_source_contract_root": { "$ref": "#/$defs/sha64" },
        "canonical_capability_id": { "$ref": "#/$defs/id" },
        "from_binding_and_anchors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
        "to_binding_and_anchors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
        "behavior_relation": { "enum": ["equivalent", "partial", "divergent", "unresolved"] },
        "known_differences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "inheritable_evidence_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "conceptual_prerequisite" }
        },
        "forbidden_inheritance": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "items": { "enum": ["execution", "navigation", "diff", "runtime"] },
          "allOf": [
            { "contains": { "const": "execution" } },
            { "contains": { "const": "navigation" } },
            { "contains": { "const": "diff" } },
            { "contains": { "const": "runtime" } }
          ]
        },
        "migration_practice_id": { "$ref": "#/$defs/id" },
        "review_event_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "enum": ["candidate", "unresolved", "reviewed"] },
        "content_hash": { "$ref": "#/$defs/sha64" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_root_hash", "projection_root", "source_contract_id", "source_contract_root"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "workspace_root_hash": { "$ref": "#/$defs/sha64" },
        "projection_root": { "$ref": "#/$defs/sha64" },
        "source_contract_id": { "$ref": "#/$defs/id" },
        "source_contract_root": { "$ref": "#/$defs/sha64" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version", "id", "workspaces", "bridge_ids", "status", "content_hash"],
      "properties": {
        "spec_version": { "const": "composition-manifest@1" },
        "id": { "$ref": "#/$defs/id" },
        "workspaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workspace" } },
        "bridge_ids": { "$ref": "#/$defs/ids" },
        "status": { "enum": ["candidate", "unresolved", "reviewed"] },
        "content_hash": { "$ref": "#/$defs/sha64" }
      }
    }
  }
}
