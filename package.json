{
  "name": "@os-camp/ptkg",
  "version": "0.3.0",
  "private": true,
  "description": "Deterministic compiler from real system projects to reviewable OS course packages",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SongShiQ/os-camp-ptkg.git"
  },
  "homepage": "https://github.com/SongShiQ/os-camp-ptkg#readme",
  "bugs": "https://github.com/SongShiQ/os-camp-ptkg/issues",
  "keywords": [
    "operating-systems",
    "curriculum",
    "knowledge-graph",
    "course-authoring",
    "rust"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "ptkg": "./src/cli.ts"
  },
  "scripts": {
    "ptkg": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  }
}
